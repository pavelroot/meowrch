{
    "layer": "top",
    "position": "left",
    "mod": "dock",
    "width": 34,
    "exclusive": false,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "margin-top": 6,
    "margin-bottom": 6,
    "margin-left": 4,

    //==> Modules Layout
    ///////////////////////////////////////////////////////////////
	"modules-left": [
		"tray",
		"hyprland/workspaces",
		"wlr/taskbar",
		"hyprland/language"
	],
	"modules-center": [
		"group/system-info"
	],
	"modules-right": [
		"group/system-levels",
		"group/clock-block",
		"group/control-panel"
	],
	"group/system-info": {
		"orientation": "vertical",
		"modules": [
			"custom/cpu",
			"custom/ram",
			"custom/gpu"
		]
	},
	"group/system-levels": {
		"orientation": "vertical",
		"modules": [
			"custom/brightness",
			"custom/battery",
			"custom/volume",
			"custom/microphone"
		]
	},
	"group/clock-block": {
		"orientation": "vertical",
		"modules": [
			"idle_inhibitor",
			"clock"
		]
	},
	"group/control-panel": {
		"orientation": "vertical",
		"modules": [
			"group/system-update-panel",
			"group/do-not-disturb-panel", 
			"group/bluetooth-panel",
			"group/networkmanager-panel",
			"group/power-panel"
		]
	},
	"group/system-update-panel": {
		"orientation": "vertical",
		"modules": ["custom/system-update"]
	},
	"group/do-not-disturb-panel": {
		"orientation": "vertical", 
		"modules": ["custom/do-not-disturb"]
	},
	"group/bluetooth-panel": {
		"orientation": "vertical",
		"modules": ["custom/bluetooth"]
	},
	"group/networkmanager-panel": {
		"orientation": "vertical",
		"modules": ["custom/networkmanager"]
	},
	"group/power-panel": {
		"orientation": "vertical",
		"modules": ["custom/power"]
	},
        
    //==> Left Modules
    ///////////////////////////////////////////////////////////////
    "tray": {
        "icon-size": 18,
        "rotate": 0,
        "spacing": 5
    },
    "hyprland/workspaces": {
        "rotate": 0,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "disable-scroll": false,
        "on-scroll-up": "hyprctl dispatch workspace -1",
        "on-scroll-down": "hyprctl dispatch workspace +1",
        "persistent-workspaces": {}
    },
	"wlr/taskbar": {
		"format": "{icon}",
		"rotate": 0,
		"icon-size": 18,
		"icon-theme": "Tela-circle-dracula",
        "spacing": 0,
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close",
		"app_ids-mapping": {
			"firefoxdeveloperedition": "firefox-developer-edition"
		}
	},



    //==> Middle Modules
    ///////////////////////////////////////////////////////////////
    "custom/cpu": {
		"exec": "python ~/bin/system-info-vertical.py --cpu --normal-color \"#1e66f5\" --critical-color \"#e64553\" | cat",
		"on-click": "python ~/bin/system-info-vertical.py --cpu --click",
		"return-type": "json",
		"format": " {}",
		"rotate": 0,
		"interval": 2,
		"tooltip": true
	},
    "custom/ram": {
		"exec": "python ~/bin/system-info-vertical.py --ram --normal-color \"#fe640b\" --critical-color \"#e64553\" | cat",
		"return-type": "json",
		"format": " {}",
		"rotate": 0,
		"interval": 2,
		"tooltip": true
	},
    "custom/gpu": {
		"exec": "python ~/bin/system-info-vertical.py --gpu --normal-color \"#dc8a78\" --critical-color \"#e64553\" | cat",
		"on-click": "python ~/bin/system-info-vertical.py --gpu --click",
		"return-type": "json",
		"format": " {}",
		"rotate": 0,
		"interval": 2,
		"tooltip": true
	},

    //==> Right Modules
    ///////////////////////////////////////////////////////////////
    "clock": {
        "format": "<span size=\"x-large\">{:%I\n%M\n%p}</span>",
        "rotate": 0,
        
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#7287fd'><b>{}</b></span>",
                "weekdays": "<span color='#7287fd'><b>{}</b></span>",
                "today": "<span color='#e64553'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "rotate": 0,
        "format-icons": {
            "activated": "󰥔 ",
            "deactivated": " "
        }
    },
    "custom/battery": {
        "exec": "sh ~/bin/battery-vertical.sh --status --discharged-color \"#e64553\" --charged-color \"#40a02b\" | cat",
        "return-type": "json",
        "format": " {}",
        "interval": 3,
        "rotate": 0,
        "on-click": "sh ~/bin/battery-vertical.sh --notify",
        "on-scroll-up": "true",
        "on-scroll-down": "true",
        "tooltip": false
    },
    "custom/brightness": {
        "exec": "sh ~/bin/brightness-vertical.sh --status --color \"#1e66f5\" | cat",
        "return-type": "json",
        "format": "&#x2004;{}",
        "interval": 1,
        "rotate": 0,
        "on-scroll-up": "sh ~/bin/brightness-vertical.sh --up",
        "on-scroll-down": "sh ~/bin/brightness-vertical.sh --down",
        "on-click-left": "sh ~/bin/brightness-vertical.sh --max",
        "on-click-right": "sh ~/bin/brightness-vertical.sh --min",
        "tooltip": false
    },
    "custom/volume": {
        "exec": "sh ~/bin/volume-vertical.sh --device output --status --disabled-color \"#e64553\" --enabled-color \"#40a02b\" | cat",
        "return-type": "json",
    	"format": " {}",
        "interval": 1,
    	"rotate": 0,
    	"on-click": "sh ~/bin/volume-vertical.sh --device output --action toggle",
    	"on-scroll-up": "sh ~/bin/volume-vertical.sh --device output --action increase",
    	"on-scroll-down": "sh ~/bin/volume-vertical.sh --device output --action decrease",
    	"scroll-step": 5,
        "tooltip": false
	},
    "custom/microphone": {
        "exec": "sh ~/bin/volume-vertical.sh --device input --status --disabled-color \"#e64553\" --enabled-color \"#40a02b\" | cat",
        "return-type": "json",
    	"format": " {}",
        "interval": 1,
    	"rotate": 0,
    	"on-click": "sh ~/bin/volume-vertical.sh --device input --action toggle",
    	"on-scroll-up": "sh ~/bin/volume-vertical.sh --device input --action increase",
    	"on-scroll-down": "sh ~/bin/volume-vertical.sh --device input --action decrease",
    	"scroll-step": 5,
        "tooltip": false
	},
	"hyprland/language": {
        "format": "{short} {variant}",
        "rotate": 0,
        "min-length": 2,
        "tooltip": false
    },
    "custom/system-update": {
        "exec": "sh ~/bin/system-update-vertical.sh --status --unupdated-color \"#df8e1d\" --updated-color \"#40a02b\" | cat",
        "return-type": "json",
        "format": "<span size=\"x-large\">{}</span>",
        "rotate": 0,
        "on-click": "CHECKUPDATES_DB=\"/tmp/checkup-db-${UID}-$$\" sh ~/bin/system-update.sh",
        "interval": 86400,
        "tooltip": false
    },
    "custom/do-not-disturb": {
        "exec": "sh ~/bin/do-not-disturb.sh --status --disabled-color \"#e64553\" --enabled-color \"#40a02b\" | cat",
        "return-type": "raw",
        "format": "&#x2004;<span size=\"x-large\">{}</span>",
        "interval": 1,
        "rotate": 0,
        "on-click": "sh ~/bin/do-not-disturb.sh",
        "tooltip": false
    },
    "custom/vpn": {
        "exec": "sh ~/bin/rofi-menus/vpn-manager.sh --status --disabled-color \"#e64553\" --enabled-color \"#40a02b\" | cat",
        "return-type": "raw",
        "format": "&#x2004;<span size=\"x-large\">{}</span>",
        "interval": 3,
        "rotate": 0,
        "on-click": "sh ~/bin/rofi-menus/vpn-manager.sh",
        "tooltip": false
    },
    "custom/bluetooth": {
        "format": "&#x2009;<span color=\"#1e66f5\" size=\"x-large\">󰂯</span>",
        "interval": 3,
        "rotate": 0,
        "on-click": "blueman-manager",
        "tooltip": false
    },
    "custom/networkmanager": {
        "exec": "sh ~/bin/rofi-menus/network-manager.sh --status --disabled-color \"#e64553\" --enabled-color \"#40a02b\" | cat",
        "return-type": "raw",
        "format": "&#x2004;<span size=\"x-large\">{}</span>",
        "interval": 3,
        "rotate": 0,
        "on-click": "sh ~/bin/rofi-menus/network-manager.sh",
        "tooltip": false
    },
    "custom/power": {
        "on-click": "sh ~/bin/rofi-menus/powermenu.sh",
        "format": "&#x2004;<span color=\"#e64553\" size=\"x-large\"></span>",
        "rotate": 0,
        "tooltip": false
    },

	
    //==> Other Modules
    ///////////////////////////////////////////////////////////////
    "custom/l_end": {
        "format": " ",
        "interval" : "once",
        "tooltip": false
    },

    "custom/r_end": {
        "format": " ",
        "interval" : "once",
        "tooltip": false
    },

    "custom/padd": {
        "format": "  ",
        "interval" : "once",
        "tooltip": false
    },

    "custom/padd_bg": {
        "format": "  ",
        "interval" : "once",
        "tooltip": false
    }
}
